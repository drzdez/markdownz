{
  "name": "markdownz",
  "private": true,
  "version": "0.3.3",
  "description": "Fast cross-platform Markdown viewer with Mermaid, math, diagrams and tabbed tree history.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "2.8.0",
    "@tauri-apps/plugin-opener": "2.6.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.1",
    "@viz-js/viz": "3.31.0",
    "dompurify": "3.4.16",
    "github-markdown-css": "5.9.0",
    "highlight.js": "11.12.0",
    "katex": "0.18.9",
    "markdown-it": "15.0.2",
    "markdown-it-anchor": "10.0.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-front-matter": "0.2.4",
    "markdown-it-github-alerts": "1.0.1",
    "markdown-it-task-lists": "2.1.1",
    "markdown-it-texmath": "1.0.0",
    "mermaid": "12.0.0",
    "pdfjs-dist": "6.3.289",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
