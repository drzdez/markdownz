[Desktop Entry]
Type=Application
Name=Markdownz
GenericName=Document Viewer
Comment=Fast Markdown and PDF viewer with Mermaid, math and diagrams
Exec=markdownz %F
Icon=io.github.drzdez.markdownz
Terminal=false
Categories=Office;Viewer;
MimeType=text/markdown;text/x-markdown;application/pdf;
Keywords=markdown;md;pdf;mermaid;katex;graphviz;viewer;
StartupNotify=true
