{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markdownz",
  "version": "../package.json",
  "identifier": "io.github.drzdez.markdownz",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Markdownz",
        "width": 1024,
        "height": 800,
        "minWidth": 420,
        "minHeight": 300,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https: http: data: blob:; media-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Markdown and PDF viewer",
    "longDescription": "Fast viewer for Markdown (with Mermaid, math and Graphviz) and PDF documents, with tabs and tree-shaped history.",
    "copyright": "© 2026 drzdez",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mkdn",
          "mdwn",
          "mdtxt",
          "mdtext"
        ],
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "text/markdown",
        "contentTypes": [
          "net.daringfireball.markdown"
        ]
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "description": "PDF document",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/pdf",
        "contentTypes": [
          "com.adobe.pdf"
        ]
      }
    ],
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "linux/markdownz.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/markdownz.desktop"
      }
    },
    "publisher": "drzdez"
  }
}
